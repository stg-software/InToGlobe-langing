# EmailJS — https://www.emailjs.com/
# Crea una cuenta gratuita en emailjs.com y completa estos valores.

# ID del servicio de email (Gmail, Outlook, etc.)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx

# Template 1: notificación interna (llega a contacto@intoglobe.com)
VITE_EMAILJS_TEMPLATE_INTERNAL=template_xxxxxxx

# Template 2: confirmación al cliente (llega al email que escribió en el form)
VITE_EMAILJS_TEMPLATE_CONFIRM=template_xxxxxxx

# Tu Public Key (Account → General → Public Key)
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
